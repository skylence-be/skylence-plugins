{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),fs=require('fs');const roots=[process.env.CODEX_PLUGIN_ROOT,process.cwd()].filter(Boolean);const r=roots.find(x=>fs.existsSync(p.join(x,'hooks','skyline-hook-runner.js')));if(!r)process.exit(0);require(p.join(r,'hooks','skyline-hook-runner.js'))('read')\"",
            "statusMessage": "Checking skyline..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|functions\\.apply_patch|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),fs=require('fs');const roots=[process.env.CODEX_PLUGIN_ROOT,process.cwd()].filter(Boolean);const r=roots.find(x=>fs.existsSync(p.join(x,'hooks','skyline-hook-runner.js')));if(!r)process.exit(0);require(p.join(r,'hooks','skyline-hook-runner.js'))('edit')\"",
            "statusMessage": "Checking skyline..."
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),fs=require('fs');const roots=[process.env.CODEX_PLUGIN_ROOT,process.cwd()].filter(Boolean);const r=roots.find(x=>fs.existsSync(p.join(x,'hooks','skyline-hook-runner.js')));if(!r)process.exit(0);require(p.join(r,'hooks','skyline-hook-runner.js'))('grep')\"",
            "statusMessage": "Checking skyline..."
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),fs=require('fs');const roots=[process.env.CODEX_PLUGIN_ROOT,process.cwd()].filter(Boolean);const r=roots.find(x=>fs.existsSync(p.join(x,'hooks','skyline-hook-runner.js')));if(!r)process.exit(0);require(p.join(r,'hooks','skyline-hook-runner.js'))('glob')\"",
            "statusMessage": "Checking skyline..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),fs=require('fs');const roots=[process.env.CODEX_PLUGIN_ROOT,process.cwd()].filter(Boolean);const r=roots.find(x=>fs.existsSync(p.join(x,'hooks','skyline-hook-runner.js')));if(!r)process.exit(0);require(p.join(r,'hooks','skyline-hook-runner.js'))('bash')\"",
            "statusMessage": "Checking skyline..."
          }
        ]
      }
    ]
  }
}
