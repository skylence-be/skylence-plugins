{
  "description": "Skyline native tool shadowing for Grok: PreToolUse redirects read_file / search_replace / run_terminal_command / grep / list_dir to the equivalent skyline_* MCP tools. Enforcement is active whenever this plugin's hooks are loaded (no fragile daemon probe).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "run_terminal_command|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/skyline-enforce.sh\" bash",
            "statusMessage": "skyline-enforce"
          }
        ]
      },
      {
        "matcher": "read_file|Read",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/skyline-enforce.sh\" read",
            "statusMessage": "skyline-enforce"
          }
        ]
      },
      {
        "matcher": "search_replace|write|Write|Edit|replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/skyline-enforce.sh\" edit",
            "statusMessage": "skyline-enforce"
          }
        ]
      },
      {
        "matcher": "grep|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/skyline-enforce.sh\" grep",
            "statusMessage": "skyline-enforce"
          }
        ]
      },
      {
        "matcher": "list_dir|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/skyline-enforce.sh\" glob",
            "statusMessage": "skyline-enforce"
          }
        ]
      }
    ]
  }
}
