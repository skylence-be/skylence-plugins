{
  "description": "Skyline native tool shadowing for Grok: PreToolUse redirects read_file / search_replace / run_terminal_command / grep / list_dir to skyline_* MCP tools with exact substitutes (daemon fail-open). Stop deposits skylore once per session. Grok SessionStart cannot inject context (observe-only), so primer/regate/nudge soft-context from skyline-claude are not ported.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "run_terminal_command|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_PLUGIN_ROOT}/hooks/skyline-enforce.js\" bash",
            "statusMessage": "skyline-enforce"
          }
        ]
      },
      {
        "matcher": "read_file|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_PLUGIN_ROOT}/hooks/skyline-enforce.js\" read",
            "statusMessage": "skyline-enforce"
          }
        ]
      },
      {
        "matcher": "search_replace|write|Write|Edit|replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_PLUGIN_ROOT}/hooks/skyline-enforce.js\" edit",
            "statusMessage": "skyline-enforce"
          }
        ]
      },
      {
        "matcher": "grep|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_PLUGIN_ROOT}/hooks/skyline-enforce.js\" grep",
            "statusMessage": "skyline-enforce"
          }
        ]
      },
      {
        "matcher": "list_dir|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_PLUGIN_ROOT}/hooks/skyline-enforce.js\" glob",
            "statusMessage": "skyline-enforce"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_PLUGIN_ROOT}/hooks/skyline-skylore-deposit.js\"",
            "statusMessage": "skyline-skylore-deposit"
          }
        ]
      }
    ]
  }
}
