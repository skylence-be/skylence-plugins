{
  "description": "Skybox CLI→MCP steering for Grok: PreToolUse on run_terminal_command/Bash and skyline_run. Structural argv + command-position detection (Claude parity). Fail-open when daemon :7070 is down.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "run_terminal_command|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_PLUGIN_ROOT}/hooks/skybox-enforce.js\"",
            "statusMessage": "skybox-enforce"
          }
        ]
      },
      {
        "matcher": "skyline_run|.*skyline_run$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_PLUGIN_ROOT}/hooks/skybox-enforce.js\"",
            "statusMessage": "skybox-enforce"
          }
        ]
      }
    ]
  }
}
