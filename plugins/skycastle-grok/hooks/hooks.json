{
  "description": "Skycastle CLI→MCP steering for Grok: PreToolUse on run_terminal_command/Bash and skyline_run. Structural argv + command-position detection (Claude parity). Only secrets/export; fail-open when daemon :8210 is down.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "run_terminal_command|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_PLUGIN_ROOT}/hooks/skycastle-enforce.js\"",
            "statusMessage": "skycastle-enforce"
          }
        ]
      },
      {
        "matcher": "skyline_run|.*skyline_run$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${GROK_PLUGIN_ROOT}/hooks/skycastle-enforce.js\"",
            "statusMessage": "skycastle-enforce"
          }
        ]
      }
    ]
  }
}
